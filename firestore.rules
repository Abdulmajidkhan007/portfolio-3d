rules_version = '2';

// Mijozdan kelgan xabarlar FAQAT Cloud Function orqali yoziladi.
// Admin SDK bu qoidalarni chetlab o'tadi, shuning uchun funksiya ishlayveradi,
// brauzerdan esa hech kim yoza ham, o'qiy ham olmaydi.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
